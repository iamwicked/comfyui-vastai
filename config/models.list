text_encoder|qwen3vl_4b_fp8_scaled.safetensors|hf|Comfy-Org/Krea-2::text_encoders/qwen3vl_4b_fp8_scaled.safetensors||wf:krea2,krea-style
vae|qwen_image_vae.safetensors|hf|Comfy-Org/Krea-2::vae/qwen_image_vae.safetensors||wf:krea2,krea-style,edit-2509
# Krea 2 Turbo (distilled, 8-10 steps / cfg 1): the base both krea2 workflows load.
diffusion|krea2_turbo_fp8_scaled.safetensors|hf|Comfy-Org/Krea-2::diffusion_models/krea2_turbo_fp8_scaled.safetensors||wf:krea2
# Krea 2 Raw (undistilled): the base Lenovo UltraReal was trained on (0.8, cfg 4, ~52 steps).
diffusion|krea2_raw_fp8_scaled.safetensors|hf|Comfy-Org/Krea-2::diffusion_models/krea2_raw_fp8_scaled.safetensors||wf:krea2
# Realism / NSFW LoRA set:
#   Lenovo UltraReal Krea 2 (creator's HF): 0.8 on Raw, 1.2-2.0 on Turbo
lora|lenovo_krea2_3000.safetensors|hf|Danrisi/Lenovo_Krea2::lenovo_krea2_3000.safetensors||wf:krea2
#   "0x7 - NSFW+ Krea2" (Civitai 3084588, 763 MB). The NSFW LLM workflow loads it as
#   Krea2/Krea2 NSFW+.safetensors @ 0.85, hence the subfolder.
lora|Krea2 NSFW+.safetensors|civitai|3084588|loras/Krea2|wf:krea2
#   darkbrush style LoRA used by the official turbo template's optional LoRA node
lora|krea2_darkbrush.safetensors|hf|Comfy-Org/Krea-2::loras/krea2_darkbrush.safetensors||wf:krea2
# Workflows:
#   Simple Krea2 NSFW+ LLM (Civitai model 2745139, version 3087685). Login-gated, so
#   fetched on-instance. Patched after download so its Advanced Prompt Enhancer uses
#   the local Ollama (dolphin3:8b): config/patches/simpleKrea2NSFWLLM_v10.json.patch.json
workflow|simpleKrea2NSFWLLM_v10.json|civitai|3087685||wf:krea2
#   Official Krea 2 Turbo t2i template (pinned)
workflow|image_krea2_turbo_t2i.json|url|https://raw.githubusercontent.com/Comfy-Org/workflow_templates/98fd32ca756dd9d72077fbe3457146d11cbc88cb/templates/image_krea2_turbo_t2i.json||wf:krea2

