{
  "format": "influencer-render-template/1",
  "meta": {
    "name": "finish",
    "kind": "finish",
    "catalog_id": "influencer",
    "identity_required": true,
    "timeout_s": 900,
    "output_node": "14",
    "placeholders": {
      "prompt": {"type": "text"},
      "seed": {"type": "int", "min": 0, "max": 4294967295},
      "character_lora": {"type": "file"},
      "character_strength": {"type": "float", "min": 0.0, "max": 2.0},
      "pick_image": {"type": "file"},
      "upscale": {"type": "int", "min": 2, "max": 4},
      "output_prefix": {"type": "text"}
    },
    "sizes": {},
    "node_packs": {
      "UNETLoader": "core",
      "CLIPLoader": "core",
      "VAELoader": "core",
      "LoraLoaderModelOnly": "core",
      "CLIPTextEncode": "core",
      "LoadImage": "core",
      "UltralyticsDetectorProvider": "ComfyUI-Impact-Subpack",
      "FaceDetailer": "ComfyUI-Impact-Pack",
      "VAEDeGrid": "ComfyUI-DeGrid",
      "VOSR2ModelLoader": "ComfyUI-VOSR2",
      "VOSR2Upscale": "ComfyUI-VOSR2",
      "SaveImage": "core"
    },
    "models": [
      {"kind": "diffusion", "folder": "diffusion_models", "name": "krea2_raw_bf16.safetensors"},
      {"kind": "text_encoder", "folder": "text_encoders", "name": "qwen3vl_4b_bf16.safetensors"},
      {"kind": "vae", "folder": "vae", "name": "Wan2_1_VAE_fp32.safetensors"},
      {"kind": "lora", "folder": "loras", "name": "krea2_turbo_lora_rank_64_bf16.safetensors"},
      {"kind": "detection", "folder": "ultralytics_bbox", "name": "face_yolov8m.pt", "value": "bbox/face_yolov8m.pt"}
    ],
    "extra_files": [
      {"folder": "vosr2", "name": "VOSR2/args.json"},
      {"folder": "vosr2", "name": "VOSR2/checkpoints/ema_model.safetensors"},
      {"folder": "vosr2", "name": "VOSR2/Qwen-Image-vae-2d/config.json"},
      {"folder": "vosr2", "name": "VOSR2/Qwen-Image-vae-2d/diffusion_pytorch_model.safetensors"},
      {"folder": "vosr2", "name": "VOSR2/dinov2_vitl14_pretrain.pth"},
      {"folder": "vosr2", "name": "VOSR2/dinov2_vitl14.safetensors", "derived": true}
    ]
  },
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {"unet_name": "krea2_raw_bf16.safetensors", "weight_dtype": "default"}
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {"clip_name": "qwen3vl_4b_bf16.safetensors", "type": "krea2", "device": "default"}
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {"vae_name": "Wan2_1_VAE_fp32.safetensors"}
    },
    "4": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {"model": ["1", 0], "lora_name": "krea2_turbo_lora_rank_64_bf16.safetensors", "strength_model": 0.6}
    },
    "5": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {"model": ["4", 0], "lora_name": "{{character_lora}}", "strength_model": "{{character_strength}}"}
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": "{{prompt}}"}
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": ""}
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {"image": "{{pick_image}}"}
    },
    "9": {
      "class_type": "UltralyticsDetectorProvider",
      "inputs": {"model_name": "bbox/face_yolov8m.pt"}
    },
    "10": {
      "class_type": "FaceDetailer",
      "inputs": {
        "image": ["8", 0], "model": ["5", 0], "clip": ["2", 0], "vae": ["3", 0],
        "positive": ["6", 0], "negative": ["7", 0], "bbox_detector": ["9", 0],
        "guide_size": 1024, "guide_size_for": true, "max_size": 1536, "seed": "{{seed}}", "steps": 8, "cfg": 1.0,
        "sampler_name": "euler", "scheduler": "beta", "denoise": 0.4, "feather": 5, "noise_mask": true,
        "force_inpaint": true, "bbox_threshold": 0.5, "bbox_dilation": 10, "bbox_crop_factor": 3.0,
        "sam_detection_hint": "center-1", "sam_dilation": 0, "sam_threshold": 0.93, "sam_bbox_expansion": 0,
        "sam_mask_hint_threshold": 0.7, "sam_mask_hint_use_negative": "False", "drop_size": 10, "wildcard": "",
        "cycle": 1, "inpaint_model": false, "noise_mask_feather": 20
      }
    },
    "11": {
      "class_type": "VAEDeGrid",
      "inputs": {
        "image": ["10", 0], "enabled": true, "mode": "auto", "limit": 0.02, "skip_when_clean": true,
        "grid_gain": 10.0, "grid_view": "4x zoom"
      }
    },
    "12": {
      "class_type": "VOSR2ModelLoader",
      "inputs": {"model": "VOSR2", "dtype": "default"}
    },
    "13": {
      "class_type": "VOSR2Upscale",
      "inputs": {
        "model": ["12", 0], "image": ["11", 0], "upscale": "{{upscale}}", "seed": "{{seed}}",
        "color_alignment": "wavelet", "tile_size": 512, "tile_overlap": 32, "vae_tile_size": 1024,
        "vae_tile_overlap": 32
      }
    },
    "14": {
      "class_type": "SaveImage",
      "inputs": {"images": ["13", 0], "filename_prefix": "{{output_prefix}}"}
    }
  }
}
